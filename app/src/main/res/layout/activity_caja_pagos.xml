<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".CajaPagos">

    <RelativeLayout
        android:id="@+id/rel"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/imgImg4"
            android:layout_width="112dp"
            android:layout_height="48dp"
            android:layout_below="@+id/relRoad"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="0dp"
            android:layout_marginRight="10dp"
            android:clickable="true"
            android:onClick="save"
            android:src="@drawable/icok" />

        <ImageView
            android:id="@+id/imageView39"
            android:layout_width="96dp"
            android:layout_height="48dp"
            android:layout_below="@+id/relRoad"
            android:layout_marginLeft="5dp"
            android:layout_marginTop="20dp"
            android:clickable="true"
            android:onClick="doExit"
            android:src="@drawable/prev48" />

        <RelativeLayout
            android:id="@+id/relRoad"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/frame_rect_blue">

            <ImageView
                android:id="@+id/imgTitLogo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_alignParentBottom="true"
                android:layout_marginBottom="5dp"
                android:adjustViewBounds="true"
                android:src="@drawable/logo_panel" />

            <ImageView
                android:id="@+id/imgRoadTit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_above="@+id/relRoadbar"
                android:layout_alignParentLeft="true"
                android:layout_alignParentTop="true"
                android:adjustViewBounds="true"
                android:background="#FFFFFF"
                android:padding="5dp"
                android:src="@drawable/existencias" />

            <RelativeLayout
                android:id="@+id/relRoadbar"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_alignParentLeft="true"
                android:layout_alignParentRight="true"
                android:layout_alignParentBottom="true"
                android:layout_centerVertical="true"
                android:background="#9A999E"></RelativeLayout>

            <TextView
                android:id="@+id/lblTit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:paddingLeft="5dp"
                android:paddingRight="5dp"
                android:text="Pago de caja"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:textColor="#FFFFFF"
                android:textSize="30sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/relRoad"
            android:layout_alignParentEnd="true"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="130dp"
            android:layout_toEndOf="@+id/imageView39">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@id/relRoad"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp">

                <Spinner
                    android:id="@+id/cboProv"
                    android:layout_width="600dp"
                    android:layout_height="50dp"
                    android:layout_alignParentTop="true"
                    android:layout_alignParentEnd="false"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginEnd="10dp"
                    android:layout_toEndOf="@+id/textView131"
                    android:background="@drawable/spinner_style" />

                <TextView
                    android:id="@+id/textView132"
                    android:layout_width="300dp"
                    android:layout_height="wrap_content"
                    android:layout_alignStart="@+id/textView131"
                    android:layout_alignTop="@+id/cboCPago"
                    android:layout_alignEnd="@+id/textView131"
                    android:layout_alignBottom="@+id/cboCPago"
                    android:layout_marginStart="0dp"
                    android:layout_marginTop="0dp"
                    android:layout_marginEnd="0dp"
                    android:layout_marginBottom="0dp"
                    android:background="@drawable/blue_strip"
                    android:gravity="center"
                    android:text="Concepto pago"
                    android:textColor="#FFFFFFFF"
                    android:textSize="24sp" />

                <Spinner
                    android:id="@+id/cboCPago"
                    android:layout_width="400dp"
                    android:layout_height="51dp"
                    android:layout_below="@+id/cboProv"
                    android:layout_alignStart="@+id/cboProv"
                    android:layout_alignEnd="@+id/cboProv"
                    android:layout_marginStart="0dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="-2dp"
                    android:background="@drawable/spinner_style" />

                <TextView
                    android:id="@+id/textView133"
                    android:layout_width="200dp"
                    android:layout_height="wrap_content"
                    android:layout_alignTop="@+id/editText17"
                    android:layout_alignBottom="@+id/editText17"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="0dp"
                    android:layout_marginEnd="2dp"
                    android:layout_toEndOf="@+id/editText17"
                    android:background="@drawable/blue_strip"
                    android:gravity="center"
                    android:text="Fecha"
                    android:textColor="#FFFFFFFF"
                    android:textSize="24sp" />

                <EditText
                    android:id="@+id/editText19"
                    android:layout_width="200dp"
                    android:layout_height="wrap_content"
                    android:layout_alignStart="@+id/cboCPago"
                    android:layout_alignTop="@+id/textView133"
                    android:layout_alignEnd="@+id/cboCPago"
                    android:layout_marginStart="380dp"
                    android:layout_marginTop="1dp"
                    android:background="#E0E0E0"
                    android:ems="10"
                    android:inputType="number|numberDecimal"
                    android:paddingLeft="10dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textView134"
                    android:layout_width="293dp"
                    android:layout_height="wrap_content"
                    android:layout_alignTop="@+id/editText20"
                    android:layout_alignEnd="@+id/textView131"
                    android:layout_alignBottom="@+id/editText20"
                    android:layout_alignParentStart="true"
                    android:background="@drawable/blue_strip"
                    android:gravity="center"
                    android:text="Documento"
                    android:textColor="#FFFFFFFF"
                    android:textSize="24sp" />

                <EditText
                    android:id="@+id/editText20"
                    android:layout_width="400dp"
                    android:layout_height="52dp"
                    android:layout_below="@+id/cboCPago"
                    android:layout_alignStart="@+id/cboCPago"
                    android:layout_alignEnd="@+id/cboCPago"
                    android:layout_marginStart="3dp"
                    android:layout_marginTop="10dp"
                    android:ems="10"
                    android:inputType="text"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textView130"
                    android:layout_width="291dp"
                    android:layout_height="44dp"
                    android:layout_alignTop="@+id/editText17"
                    android:layout_alignBottom="@+id/editText17"
                    android:layout_alignParentStart="true"
                    android:layout_marginStart="0dp"
                    android:layout_toStartOf="@+id/cboProv"
                    android:background="@drawable/blue_strip"
                    android:gravity="center"
                    android:text="Monto"
                    android:textColor="#FFFFFFFF"
                    android:textSize="24sp" />

                <EditText
                    android:id="@+id/editText17"
                    android:layout_width="150dp"
                    android:layout_height="52dp"
                    android:layout_below="@+id/editText20"
                    android:layout_alignStart="@+id/editText20"
                    android:layout_marginStart="0dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="0dp"
                    android:ems="10"
                    android:inputType="numberDecimal"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/editText22"
                    android:layout_width="384dp"
                    android:layout_height="50dp"
                    android:layout_below="@+id/editText17"
                    android:layout_alignStart="@+id/editText17"
                    android:layout_alignEnd="@+id/editText19"
                    android:layout_marginStart="0dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="0dp"
                    android:ems="10"
                    android:gravity="start|top"
                    android:inputType="text"
                    android:maxLength="50"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textView144"
                    android:layout_width="291dp"
                    android:layout_height="50dp"
                    android:layout_below="@+id/textView130"
                    android:layout_alignEnd="@+id/textView131"
                    android:layout_alignParentStart="true"
                    android:layout_marginStart="0dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/blue_strip"
                    android:gravity="center"
                    android:text="Descripcion"
                    android:textColor="#FFFFFFFF"
                    android:textSize="24sp" />

                <TextView
                    android:id="@+id/textView131"
                    android:layout_width="200dp"
                    android:layout_height="50dp"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentTop="true"
                    android:layout_marginStart="0dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/blue_strip"
                    android:gravity="center"
                    android:text="Proveedor"
                    android:textColor="#FFFFFFFF"
                    android:textSize="24sp" />
            </RelativeLayout>
        </ScrollView>

    </RelativeLayout>
</RelativeLayout>